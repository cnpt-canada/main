# Environment variables for the Vercel functions in api/.
# Set them in Vercel → Project → Settings → Environment Variables (Production, and Preview if you use it).
# Nothing here has to be provisioned: the forms end in an email, and admin mode signs in with Google
# and saves by committing to this repository. There is still no database.

# ─── Form emails (Resend) ───
# resend.com → API Keys. Until a domain is verified there, CONTACT_TO must be the address the
# Resend account was created with.
RESEND_API_KEY=
CONTACT_TO=
# Optional, once cnpt.ca is verified in Resend, e.g.  cnpt <hello@cnpt.ca>
CONTACT_FROM=
# Where the talent pool form (/network#talent) sends its messages. Falls back to CONTACT_TO.
TALENT_TO=talent@cnpt.ca

# ─── Admin mode (the mark at the foot of the page) ───
# Leave any of these empty and there is no editor: the site works exactly as it does now and the
# mark answers that admin mode is not set up. See SETUP.md for the Google Cloud side.

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised JavaScript origin: https://cnpt.ca  — no redirect URI, the sign-in never leaves the page.
# There is no client secret here: the browser gets the token and this site only verifies it.
GOOGLE_CLIENT_ID=
# Who may edit, by Google address. Comma separated, and checked on every request.
ADMIN_EMAILS=
# Signs the session cookie. Any 32+ random characters: `openssl rand -base64 32`. Changing it signs everyone out.
ADMIN_SECRET=

# Where a save is committed. A fine-grained token for this repository alone, Contents: read and write.
# The commit deploys, so this token can publish the site — treat it like one.
GITHUB_REPO=cnpt-canada/main
GITHUB_TOKEN=
# Optional, defaults to main
GITHUB_BRANCH=main
