# Environment variables for the Vercel functions in api/.
# Set them in Vercel → Project → Settings → Environment Variables (Production, and Preview if you use it).
# SETUP.md walks through where each value comes from.

# ─── Sign-in with Google ───
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The site's public address, e.g. https://cnpt.ca — must match the redirect URI registered with Google
# (<PUBLIC_URL>/api/auth/callback). Leave empty to use whatever host the request came in on.
PUBLIC_URL=

# Google accounts that are always admins (comma-separated). They can grant admin access to others on /admin.
ADMIN_EMAILS=

# ─── Database (Supabase) ───
# app.supabase.com → Project Settings → API. The service-role key is server-only: never put it in a page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Enquiry emails (Resend, optional) ───
# Enquiries are always saved to the database and shown on /admin. Set these to also get them by email.
# Until a domain is verified in Resend, CONTACT_TO must be the address the Resend account was created with.
RESEND_API_KEY=
CONTACT_TO=
# Optional, once cnpt.ca is verified in Resend, e.g.  cnpt <hello@cnpt.ca>
CONTACT_FROM=
# Where the talent pool form (/talent) sends its messages. Falls back to CONTACT_TO.
TALENT_TO=talent@cnpt.ca
