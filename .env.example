# Contact form (api/contact.js) — set these in Vercel → Project → Settings → Environment Variables.

# https://resend.com → API Keys
RESEND_API_KEY=re_...

# Inbox(es) that receive enquiries, comma-separated.
# Until a domain is verified in Resend, this must be the email address the Resend account was created with.
CONTACT_TO=you@example.com

# Optional. Once cnpt.ca is verified in Resend, e.g.:  cnpt <hello@cnpt.ca>
# CONTACT_FROM=
