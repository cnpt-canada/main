# Environment variables for the Vercel functions in api/.
# Set them in Vercel → Project → Settings → Environment Variables (Production, and Preview if you use it).
# Nothing here has to be provisioned: the forms end in an email, and admin mode signs in with Google
# and saves by committing to this repository. There is still no database.

# ─── Form emails (Resend) ───
# resend.com → API Keys. Until a domain is verified there, CONTACT_TO must be the address the
# Resend account was created with.
RESEND_API_KEY=
CONTACT_TO=
# Optional, once cnpt.ca is verified in Resend, e.g.  cnpt <hello@cnpt.ca>
CONTACT_FROM=
# Where the talent pool form (/network#talent) sends its messages. Falls back to CONTACT_TO.
TALENT_TO=talent@cnpt.ca

# ─── Admin mode (© 2026 cnpt, at the foot of the page) ───
# Signing in needs nothing here: the Google client id and the editors live in api/_lib/admin.js
# (the id is public, the addresses are held as hashes), and the callback it uses is already an
# authorised redirect URI on that client. These two only override them.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# Saving does need these. A fine-grained token for this repository alone, Contents: read and write.
# The commit deploys, so this token can publish the site — treat it like one.
GITHUB_REPO=cnpt-canada/main
GITHUB_TOKEN=
# Optional, defaults to main
GITHUB_BRANCH=main
